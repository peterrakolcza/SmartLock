# USB-powered version, layered on sdkconfig.defaults:
#   idf.py -B build_usb -D SDKCONFIG=build_usb/sdkconfig -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.usb" build
# Always powered: Thread runs as a full router (it also extends your Thread network), nothing sleeps.
CONFIG_SMARTLOCK_USB_POWERED=y
CONFIG_OPENTHREAD_FTD=y
# CONFIG_OPENTHREAD_MTD is not set
# CONFIG_ENABLE_ICD_SERVER is not set
# CONFIG_PM_ENABLE is not set
# CONFIG_FREERTOS_USE_TICKLESS_IDLE is not set
# CONFIG_IEEE802154_SLEEP_ENABLE is not set
# CONFIG_BT_LE_SLEEP_ENABLE is not set
# CONFIG_ESP_SLEEP_POWER_DOWN_FLASH is not set
